# Dusk browser-test environment.
#
# Copy to .env.dusk.local and set a real APP_KEY (php artisan key:generate --show).
# While `php artisan dusk` runs, this file REPLACES .env (Dusk backs the original
# up to .env.backup and restores it afterwards) — so it must be complete, and it
# must never point at MySQL. tests/DuskTestCase.php hard-aborts unless the boot
# lands on testing + sqlite + a database path ending in dusk.sqlite.
#
# Local flow (two terminals):
#   1. php artisan serve          (127.0.0.1:8000 — re-reads .env per request,
#                                  so it picks up this file during the run)
#   2. php artisan dusk

APP_NAME=GadgetDrop
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

# Sqlite FILE db (never :memory: — the serve process and the test process must
# see the same database; never MySQL — DatabaseMigrations runs migrate:fresh).
# The relative path resolves against base_path() (SQLiteConnector fallback).
DB_CONNECTION=sqlite
DB_DATABASE=database/dusk.sqlite

CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
MAIL_MAILER=array
BROADCAST_CONNECTION=null

AMAZON_AFFILIATE_TAG=dusk-test-20
ADSENSE_ENABLED=false
SOCIAL_ENABLED=false

# Hermeticity: blank every external-service credential (mirrors phpunit.xml).
GSC_PROPERTY=
GSC_CREDENTIALS_PATH=
BING_WEBMASTER_API_KEY=
INDEXNOW_KEY=
BLUESKY_APP_PASSWORD=
FACEBOOK_PAGE_TOKEN=
CANOPY_API_KEY=
PULSE_ENABLED=false
TELESCOPE_ENABLED=false
NIGHTWATCH_ENABLED=false
