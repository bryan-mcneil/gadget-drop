APP_NAME=GadgetDrop
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://gadget-drop.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gadget_drop
DB_USERNAME=root
DB_PASSWORD=

# DANGER: only ever true when you INTEND destructive artisan commands
# (migrate:fresh etc.) to run outside env=testing — see CLAUDE.md Tests.
# DB_ALLOW_DESTRUCTIVE=false

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Appended to every /out/{product} affiliate redirect — never hard-coded in URLs
AMAZON_AFFILIATE_TAG=

GADGETDROP_API_KEY=

# AdSense stays off until explicitly enabled in prod (config default is false)
ADSENSE_ENABLED=false

# Price refresh — Canopy FREE tier only (budget-guarded); PA-API is the upgrade path
# CANOPY_API_KEY=

# Search Intel (GSC/Bing/IndexNow) — all no-op when unset
GSC_PROPERTY=
GSC_CREDENTIALS_PATH=
BING_WEBMASTER_API_KEY=
INDEXNOW_KEY=
# php -r "echo bin2hex(random_bytes(16)), PHP_EOL;"
# SEARCH_PING_ENABLED=false        # prod ONLY — leave off/absent locally so dev never pings
# optional overrides (already default to these):
# SEARCH_SITE_URL=https://gadgetdrop.tech
# BING_SITE_URL=https://gadgetdrop.tech/

# Social auto-posting (Bluesky + Facebook); X is manual via /admin/social
SOCIAL_ENABLED=false
SOCIAL_BLUESKY_ENABLED=false
SOCIAL_BLUESKY_MODE=live
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
SOCIAL_FACEBOOK_ENABLED=false
SOCIAL_FACEBOOK_MODE=live
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=
